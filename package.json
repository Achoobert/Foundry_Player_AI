{
	"name": "foundry-ai",
	"version": "1.3.0",
	"description": "FoundryAI - AI-powered DM assistant for Foundry VTT",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"watch": "vite build --watch",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src/",
		"typecheck": "tsc --noEmit",
		"link": "node scripts/link-module.mjs",
		"package": "node scripts/package-module.mjs",
		"release": "node scripts/release.mjs",
		"publish": "node scripts/publish.mjs",
		"cypress:install": "cypress install",
		"test:e2e": "cypress open",
		"test:ci": "cypress run --headless --browser chrome"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tsconfig/svelte": "^5.0.0",
		"cypress": "^15.17.0",
		"cypress-if": "^1.13.2",
		"eslint": "^9.0.0",
		"sass": "^1.80.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"micromark": "^4.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"micromark-extension-gfm-table": "^2.0.0"
	}
}
